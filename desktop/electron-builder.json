{
  "appId": "com.stockflow.desktop",
  "productName": "StockFlow AI Desktop",
  "copyright": "Copyright © 2026 StockFlow AI",
  "directories": {
    "output": "dist",
    "buildResources": "src/assets"
  },
  "files": [
    "src/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "StockFlow AI Desktop"
  }
}
