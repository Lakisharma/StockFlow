# StockFlow AI - Production Environment Configuration Template
# Duplicate this file to '.env' and populate with production credentials.

# Django Security Settings
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DEBUG=False
ALLOWED_HOSTS=stockflow.example.com,www.example.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://stockflow.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://stockflow.example.com,https://www.example.com

# Production Database (PostgreSQL)
# Format: postgres://username:password@hostname:port/database_name
DATABASE_URL=postgres://stockflow_user:secure_password@localhost:5432/stockflow_db

# Production Redis & Background Queue (Optional)
REDIS_URL=redis://localhost:6379/0

# Production SMTP Email Server Settings
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=postmaster@stockflow.example.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=StockFlow AI Notifications <noreply@stockflow.example.com>

# AI & OCR Service API Keys (Optional)
OCR_API_KEY=your-ocr-service-api-key
AI_API_KEY=your-ai-service-api-key

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
